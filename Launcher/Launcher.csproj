<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HytaleAccounts</AssemblyName>
    <Version>0.1.3</Version>
    <!-- WPF native files ship beside apphost: ordinary startup must never extract into a cache. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ElevatedRuntime.ps1" LogicalName="HytaleAccounts.ElevatedRuntime.ps1" />
    <EmbeddedResource Include="NativeDropdown.js" LogicalName="HytaleAccounts.NativeDropdown.js" />
    <EmbeddedResource Include="../Install.ps1" LogicalName="HytaleAccounts.Install.ps1" />
    <EmbeddedResource Include="../Uninstall.ps1" LogicalName="HytaleAccounts.Uninstall.ps1" />
    <EmbeddedResource Include="../InstallerSafety.ps1" LogicalName="HytaleAccounts.InstallerSafety.ps1" />
    <EmbeddedResource Include="../Repair-Integration.ps1" LogicalName="HytaleAccounts.Repair-Integration.ps1" />
    <EmbeddedResource Include="../ShortcutIntegration.ps1" LogicalName="HytaleAccounts.ShortcutIntegration.ps1" />
    <EmbeddedResource Include="../ShortcutFile.cs" LogicalName="HytaleAccounts.ShortcutFile.cs" />
  </ItemGroup>
</Project>
